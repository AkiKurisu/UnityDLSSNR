+int RenderAPI_D3D12::SetBindlessTextures(int offset, unsigned numTextures, BindlessTexture* textures
+) {
+	if (!isInitialized) {
+		UnityLog::LogError("Plugin is not initialized, try restart Unity Editor\n");
+		return 0;
+	}
+
+	if (myD3D12->hookedDescriptorHeaps.empty()) {
+		UnityLog::LogError("SetBindlessTextures is called, but no srvHeap is set.\n");
+		return 0;
+	}
+
+	std::lock_guard<std::mutex> lock(slotMutex);
+	if (slotEntries.size() < numAdditionalSrv()) {
+		slotEntries.resize(numAdditionalSrv());
+		slotResources.resize(numAdditionalSrv(), nullptr);
+	}
+	if (offset < 0 || offset + numTextures > slotEntries.size()) {
+		UnityLog::LogError("SetBindlessTextures is out of range.\n");
+		return 0;
+	}
+
+	std::vector<ID3D12Pageable*> resources(numTextures, nullptr);
+	for (unsigned i = 0; i < numTextures; i++) {
+		const auto& entry = textures[i];
+		if (entry.type != BindlessTextureType::Resource && entry.type != BindlessTextureType::RawBuffer)
+			continue;
+		resources[i] = static_cast<ID3D12Resource*>(entry.handle);
+		HRESULT hr = device->MakeResident(1, &resources[i]);
+		if (FAILED(hr)) {
+			for (unsigned j = 0; j < i; j++) {
+				if (!resources[j]) continue;
+				device->Evict(1, &resources[j]);
+				resources[j]->Release();
+			}
+			UnityLog::LogError("Cannot make bindless resource %u resident (0x%08X).\n", offset + i, hr);
+			return 0;
+		}
+		resources[i]->AddRef();
+	}
+	for (unsigned i = 0; i < numTextures; i++) {
+		if (slotResources[offset + i]) {
+			auto resource = static_cast<ID3D12Pageable*>(slotResources[offset + i]);
+			device->Evict(1, &resource);
+			resource->Release();
+		}
+		slotResources[offset + i] = resources[i];
+		slotEntries[offset + i] = textures[i];
+	}
+
+	for (auto heap : this->hookedDescriptorHeaps)
+		WriteDescriptors(heap, (unsigned)offset, numTextures);
 
 	return 1;
 }
 
+int RenderAPI_D3D12::GetBindlessCapacity() {
+	return isInitialized && !hookedDescriptorHeaps.empty() ? (int)numAdditionalSrv() : 0;
+}
